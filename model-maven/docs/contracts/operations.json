{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-maven.local/contracts/operations-v2.json",
  "title": "Model-Maven operation plan contract v2",
  "description": "Version 2 is produced and consumed by the application service for supported operations; conditional capability state is preserved separately from unknown.",
  "type": "object",
  "required": [
    "contract_version",
    "plan_id",
    "operation",
    "readiness",
    "inputs"
  ],
  "properties": {
    "contract_version": {
      "const": 2
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "readiness": {
      "$ref": "#/$defs/readiness"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inputBinding"
      }
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "readiness": {
            "properties": {
              "state": {
                "const": "ready"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "readiness": {
            "properties": {
              "facts": {
                "items": {
                  "$ref": "#/$defs/availableWhenRequired"
                }
              },
              "capabilities": {
                "items": {
                  "$ref": "#/$defs/availableWhenRequired"
                }
              }
            }
          },
          "inputs": {
            "items": {
              "$ref": "#/$defs/availableWhenRequired"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "readiness": {
            "properties": {
              "state": {
                "const": "conditional"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "readiness": {
            "properties": {
              "conditions": {
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "factState": {
      "type": "string",
      "enum": [
        "available",
        "missing",
        "unsupported",
        "conditional",
        "unknown"
      ]
    },
    "readinessState": {
      "type": "string",
      "enum": [
        "ready",
        "needs_input",
        "conditional",
        "unsupported",
        "unknown"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "project_config",
            "command_line",
            "user_session",
            "saved_run",
            "model_variant",
            "data_adapter",
            "user_callable",
            "generated",
            "external",
            "unknown"
          ]
        },
        "reference": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "inputBinding": {
      "type": "object",
      "required": [
        "key",
        "state",
        "source",
        "required",
        "sensitive"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/factState"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "value": {},
        "required": {
          "type": "boolean"
        },
        "sensitive": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "fact": {
      "type": "object",
      "required": [
        "key",
        "state",
        "required"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/factState"
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "additionalProperties": true
    },
    "capability": {
      "type": "object",
      "required": [
        "id",
        "state",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/factState"
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "label",
        "availability"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "type": "string",
          "enum": [
            "available",
            "conditional",
            "unsupported",
            "unknown"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "readiness": {
      "type": "object",
      "required": [
        "state",
        "facts",
        "capabilities",
        "conditions",
        "actions"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/readinessState"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      },
      "additionalProperties": true
    },
    "operationRequest": {
      "type": "object",
      "required": [
        "contract_version",
        "operation",
        "inputs",
        "parameters"
      ],
      "properties": {
        "contract_version": {
          "const": 2
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputBinding"
          }
        },
        "parameters": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "availableWhenRequired": {
      "if": {
        "properties": {
          "required": {
            "const": true
          }
        },
        "required": [
          "required"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "const": "available"
          }
        }
      }
    },
    "modelIdentity": {
      "type": "object",
      "required": [
        "model_ref"
      ],
      "properties": {
        "model_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string"
        },
        "variant_ref": {
          "type": "string"
        },
        "variant_revision": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "moduleInvocationIdentity": {
      "type": "object",
      "required": [
        "probe_id",
        "forward_id",
        "batch_id",
        "module_instance_id",
        "invocation_index",
        "alias_paths",
        "input_output_paths"
      ],
      "properties": {
        "probe_id": {
          "type": "string",
          "minLength": 1
        },
        "forward_id": {
          "type": "string",
          "minLength": 1
        },
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "module_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "invocation_index": {
          "type": "integer",
          "minimum": 1
        },
        "parent_invocation_id": {
          "type": "string"
        },
        "alias_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "input_output_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "callsite": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "stateDisposition": {
      "type": "string",
      "enum": [
        "preserved",
        "reset",
        "migrated",
        "not_applicable",
        "unknown"
      ]
    },
    "stateImpact": {
      "type": "object",
      "required": [
        "model_weights",
        "optimizer_state",
        "random_state",
        "data_cursor",
        "scheduler_state",
        "notes"
      ],
      "properties": {
        "model_weights": {
          "$ref": "#/$defs/stateDisposition"
        },
        "optimizer_state": {
          "$ref": "#/$defs/stateDisposition"
        },
        "random_state": {
          "$ref": "#/$defs/stateDisposition"
        },
        "data_cursor": {
          "$ref": "#/$defs/stateDisposition"
        },
        "scheduler_state": {
          "$ref": "#/$defs/stateDisposition"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "editPlan": {
      "type": "object",
      "required": [
        "plan_id",
        "base_revision",
        "state",
        "operations",
        "impact"
      ],
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "base_revision": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "needs_decision",
            "ready_to_apply",
            "applied",
            "rejected",
            "stale",
            "unknown"
          ]
        },
        "operations": {
          "type": "array"
        },
        "impact": {
          "$ref": "#/$defs/stateImpact"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ready_to_apply"
              }
            }
          },
          "then": {
            "properties": {
              "operations": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "artifactRef": {
      "type": "object",
      "required": [
        "artifact_id",
        "kind",
        "uri",
        "owner_operation_id"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "owner_operation_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "operationEvent": {
      "type": "object",
      "required": [
        "operation_id",
        "sequence",
        "kind",
        "state",
        "artifacts"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "minLength": 1
        },
        "progress": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "message": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        }
      },
      "additionalProperties": true
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "required": [
            "severity",
            "recovery_actions",
            "evidence_state"
          ],
          "properties": {
            "severity": {
              "type": "string",
              "enum": [
                "info",
                "warning",
                "error",
                "fatal"
              ]
            },
            "scope": {
              "type": "object",
              "properties": {
                "operation_id": {
                  "type": "string"
                },
                "model_ref": {
                  "type": "string"
                },
                "source_revision": {
                  "type": "string"
                },
                "batch_ref": {
                  "type": "string"
                },
                "run_id": {
                  "type": "string"
                },
                "module_path": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "recovery_actions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "label",
                  "availability",
                  "requires_confirmation"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "availability": {
                    "type": "string",
                    "enum": [
                      "available",
                      "conditional",
                      "unsupported",
                      "unknown"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  },
                  "requires_confirmation": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": true
              }
            },
            "evidence_state": {
              "type": "string",
              "enum": [
                "complete",
                "partial",
                "unknown",
                "not_applicable"
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "contract_status": {
    "protocol": "proposed",
    "current_report_shell": "implemented",
    "planner_and_typed_operation_service": "proposed"
  },
  "readiness_semantics": {
    "ready": "当前所选操作的必要输入与能力均 available。",
    "needs_input": "一个或多个必要事实为 missing；只阻塞所选操作。",
    "unsupported": "必要能力明确不受当前 provider 支持。",
    "conditional": "可执行但必须先满足列明的条件或用户决策；conditions 必须非空。",
    "unknown": "没有足够证据判断；不得降格成 available 或成功。",
    "optional_unknown": "required=false 的事实或能力不会阻止 ready；仍须如实展示。"
  },
  "operation_catalog": {
    "authority": "product.json#/behavior_contracts/G-validation/operation_requirements",
    "execution_owner_semantics": {
      "python_worker": "worker_operation must be a registered key in compatibility.json.operations; dispatch and feature presence are checked against the live worker registry.",
      "rust_cli": "The operation is completed by Rust-side adapters/services and must not claim a Python worker operation.",
      "current_cli": "Each documented CLI path must resolve in the derived public Clap command tree; alternatives use slash-separated command names and option tokens are checked on the owning command."
    },
    "operations": {
      "inspect_model": {
        "required": [
          "可构造的模型入口及其实际所需参数"
        ],
        "not_required": [
          "示例批次",
          "完整数据适配器",
          "train.mode",
          "训练步骤",
          "Loss",
          "优化器",
          "评估器"
        ],
        "current_cli": "model inspect",
        "worker_operation": "inspect",
        "execution_status": "implemented",
        "plan_status": "proposed",
        "execution_owner": "python_worker"
      },
      "forward_probe": {
        "required": [
          "可构造的模型入口",
          "一个示例批次及可执行的 forward 参数绑定"
        ],
        "not_required": [
          "DataLoader",
          "train.mode",
          "训练步骤",
          "Loss",
          "优化器",
          "评估器"
        ],
        "current_cli": "model probe",
        "worker_operation": "probe",
        "execution_status": "implemented",
        "plan_status": "proposed",
        "execution_owner": "python_worker"
      },
      "loss_probe": {
        "required": [
          "模型与批次",
          "无更新的 Loss 计算入口或 managed-step 的前向/Loss 能力"
        ],
        "not_required": [
          "优化器",
          "完整训练循环"
        ],
        "current_cli": "model verify --loss",
        "worker_operation": "verify",
        "execution_status": "partial: 当前 verify 会执行 backward；独立只算 Loss 的操作未接入",
        "plan_status": "proposed",
        "execution_owner": "python_worker"
      },
      "training_probe": {
        "required": [
          "当前训练模式所需输入",
          "适配器可预算执行的步骤与所需观测能力"
        ],
        "training_mode_requirements": true,
        "current_cli": "try",
        "worker_operation": "training_probe",
        "execution_status": "implemented",
        "plan_status": "proposed",
        "execution_owner": "python_worker"
      },
      "managed_train": {
        "required": [
          "当前 managed/manual 训练模式所需输入",
          "可停止和可报告进度的执行适配器"
        ],
        "training_mode_requirements": true,
        "current_cli": "train",
        "worker_operation": "train",
        "execution_status": "implemented",
        "plan_status": "proposed",
        "execution_owner": "python_worker"
      },
      "external_train": {
        "required": [
          "可调用 train.loop 及其实际参数"
        ],
        "not_required": [
          "独立 data 字段",
          "独立 model 字段",
          "项目优化器声明",
          "评估器"
        ],
        "current_cli": "train --loop",
        "worker_operation": "train",
        "execution_status": "implemented",
        "plan_status": "proposed",
        "execution_owner": "python_worker"
      },
      "resume_train": {
        "required": [
          "明确可解析的来源运行",
          "可用 checkpoint 与适配器恢复协议",
          "T-continue 兼容性检查"
        ],
        "not_required": [
          "与该循环无关的额外数据或模型描述"
        ],
        "current_cli": "train --resume",
        "worker_operation": "train",
        "execution_status": "partial: 已支持内建状态恢复；完整自定义状态兼容仍受声明协议限制",
        "plan_status": "proposed",
        "execution_owner": "python_worker"
      },
      "inspect_component": {
        "required": [
          "一个注册或临时组件描述"
        ],
        "not_required": [
          "完整训练配置"
        ],
        "current_cli": "component show/list",
        "execution_status": "implemented",
        "plan_status": "proposed",
        "execution_owner": "rust_cli"
      },
      "inspect_layers": {
        "required": [
          "可构造模型或与当前来源匹配的结构证据"
        ],
        "not_required": [
          "训练步骤",
          "Loss",
          "优化器"
        ],
        "current_cli": "layer list",
        "worker_operation": "layers",
        "execution_status": "implemented",
        "plan_status": "proposed",
        "execution_owner": "python_worker"
      },
      "plan_layer_edit": {
        "required": [
          "可解析模型来源和明确 Layer 选择",
          "目标持久化方式与适用编辑提供者"
        ],
        "not_required": [
          "训练循环",
          "优化器"
        ],
        "current_cli": "layer add/set/replace/remove --dry-run",
        "worker_operation": "edit",
        "execution_status": "partial: 当前 CRUD 计划能力已接入；统一多来源计划/冲突状态待 EDIT",
        "plan_status": "proposed",
        "execution_owner": "python_worker"
      },
      "apply_layer_edit": {
        "required": [
          "基础版本仍匹配的编辑计划",
          "必需检查通过及已明确的状态/连接策略",
          "目标可写或可保存变体"
        ],
        "not_required": [
          "完整训练接入"
        ],
        "current_cli": "layer add/set/replace/remove",
        "worker_operation": "edit",
        "execution_status": "partial: variant/source 事务已实现；统一 state impact 与迁移能力待 EDIT",
        "plan_status": "proposed",
        "execution_owner": "python_worker"
      },
      "test_extension": {
        "required": [
          "扩展描述/入口与对应能力测试夹具"
        ],
        "not_required": [
          "全部训练功能"
        ],
        "current_cli": "component test",
        "worker_operation": "component_test",
        "execution_status": "implemented",
        "plan_status": "proposed",
        "execution_owner": "python_worker"
      },
      "evaluate": {
        "required": [
          "已结束的训练运行和可验证 checkpoint",
          "当前模型源码与训练时模型源码一致",
          "项目评估入口与指定数据切分"
        ],
        "not_required": [
          "训练步骤",
          "优化器",
          "分类 logits 或单一标签结构"
        ],
        "current_cli": "evaluate --run <id> --evaluator <module:callable> --data <module:factory>",
        "worker_operation": "evaluate",
        "execution_status": "implemented: custom task evaluator, checkpoint verification and source/data provenance",
        "plan_status": "proposed",
        "execution_owner": "python_worker"
      },
      "data_classification_index": {
        "required": [
          "可读取的分类目录（类别子目录）",
          "项目元数据目录"
        ],
        "not_required": [
          "PyTorch",
          "模型入口",
          "训练器"
        ],
        "current_cli": "data index --root <CLASS_FOLDER> --verify",
        "worker_operation": "data_index",
        "execution_status": "implemented",
        "plan_status": "proposed",
        "execution_owner": "python_worker",
        "notes": [
          "完整扫描内容指纹；verify 显式解码全部索引图像。",
          "损坏文件排除须用户选择并确认；原始文件不会被改动。",
          "分类预设只应用根路径与源指纹匹配的项目协议，源内容变化后拒绝静默复用。"
        ]
      }
    }
  },
