{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-maven.dev/schemas/value-validation-record-v1.json",
  "title": "Model-Maven anonymized paired observation record",
  "description": "One consented user observation. Do not place personal data, raw paths, credentials, source code, or sample contents in free-text fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_status",
    "record_id",
    "date_utc",
    "participant_code",
    "consent_confirmed",
    "recording_consent",
    "participant_context",
    "comparison_conditions",
    "task_events",
    "summary",
    "anonymization_reviewed"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_status": { "enum": ["template_only", "observed", "withdrawn"] },
    "record_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$" },
    "date_utc": { "type": "string", "format": "date" },
    "observer_code": { "type": ["string", "null"], "maxLength": 64 },
    "participant_code": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,31}$" },
    "consent_confirmed": { "type": "boolean" },
    "recording_consent": { "type": "boolean" },
    "participant_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experience_summary", "model_task_type", "python_version", "pytorch_version", "hardware_class", "data_location_class", "existing_tools", "reusable_assets", "known_inapplicable_capabilities"],
      "properties": {
        "experience_summary": { "type": "string", "maxLength": 500 },
        "model_task_type": { "type": "string", "maxLength": 300 },
        "python_version": { "type": ["string", "null"], "maxLength": 64 },
        "pytorch_version": { "type": ["string", "null"], "maxLength": 64 },
        "hardware_class": { "type": ["string", "null"], "maxLength": 200 },
        "data_location_class": { "enum": ["local", "remote", "mixed", "not_applicable", "not_measured"] },
        "existing_tools": { "$ref": "#/$defs/stringList" },
        "reusable_assets": { "$ref": "#/$defs/stringList" },
        "known_inapplicable_capabilities": { "$ref": "#/$defs/stringList" }
      }
    },
    "comparison_conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_summary", "model_and_initialization", "input_summary", "environment_and_cache", "help_available", "method_order", "comparison_limitations"],
      "properties": {
        "project_summary": { "type": "string", "maxLength": 500 },
        "model_and_initialization": { "type": "string", "maxLength": 500 },
        "input_summary": { "type": "string", "maxLength": 500 },
        "environment_and_cache": { "type": "string", "maxLength": 500 },
        "help_available": { "type": "string", "maxLength": 300 },
        "method_order": { "enum": ["existing_then_model_maven", "model_maven_then_existing", "other", "not_applicable"] },
        "comparison_limitations": { "$ref": "#/$defs/stringList" }
      }
    },
    "task_events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/taskEvent" }
    },
    "layer_or_training_follow_up": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["attempted", "operations", "reload_or_resume_verified", "state_effect_explained", "extra_files_or_code", "elapsed_seconds", "outcome"],
      "properties": {
        "attempted": { "type": "boolean" },
        "operations": { "$ref": "#/$defs/stringList" },
        "reload_or_resume_verified": { "enum": ["yes", "no", "not_applicable", "not_measured"] },
        "state_effect_explained": { "enum": ["yes", "no", "partly", "not_applicable", "not_measured"] },
        "extra_files_or_code": { "type": ["integer", "null"], "minimum": 0 },
        "elapsed_seconds": { "$ref": "#/$defs/measurement" },
        "outcome": { "type": "string", "maxLength": 1000 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_preference_and_reason", "existing_workflow_wins", "model_maven_helps_or_hurts", "comprehension_or_correctness_regressions", "unmet_need", "confidence", "follow_up_to_test"],
      "properties": {
        "participant_preference_and_reason": { "type": "string", "maxLength": 1000 },
        "existing_workflow_wins": { "type": "string", "maxLength": 1000 },
        "model_maven_helps_or_hurts": { "type": "string", "maxLength": 1000 },
        "comprehension_or_correctness_regressions": { "type": "string", "maxLength": 1000 },
        "unmet_need": { "type": "string", "maxLength": 1000 },
        "confidence": { "enum": ["low", "medium", "high", "not_assessed"] },
        "confidence_reason": { "type": ["string", "null"], "maxLength": 500 },
        "follow_up_to_test": { "$ref": "#/$defs/stringList" }
      }
    },
    "anonymization_reviewed": { "type": "boolean" },
    "withdrawal_note": { "type": ["string", "null"], "maxLength": 300 }
  },
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 50 },
    "measurement": { "type": ["number", "null"], "minimum": 0 },
    "taskEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "task", "outcome", "measurements", "added_files", "added_or_changed_lines", "repeated_inputs", "observer_prompts", "help_or_tool_exits", "mistaken_or_cancelled_actions", "correctness_check", "participant_explanation", "failure_or_limitation"],
      "properties": {
        "method": { "enum": ["existing_workflow", "model_maven"] },
        "task": { "type": "string", "maxLength": 500 },
        "outcome": { "enum": ["completed", "not_completed", "not_applicable", "unknown", "withdrawn"] },
        "measurements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preparation_seconds", "migration_seconds", "first_inspect_seconds", "first_valid_diagnostic_seconds", "first_real_sample_seconds", "repair_and_repeat_seconds", "total_seconds"],
          "properties": {
            "preparation_seconds": { "$ref": "#/$defs/measurement" },
            "migration_seconds": { "$ref": "#/$defs/measurement" },
            "first_inspect_seconds": { "$ref": "#/$defs/measurement" },
            "first_valid_diagnostic_seconds": { "$ref": "#/$defs/measurement" },
            "first_real_sample_seconds": { "$ref": "#/$defs/measurement" },
            "repair_and_repeat_seconds": { "$ref": "#/$defs/measurement" },
            "total_seconds": { "$ref": "#/$defs/measurement" }
          }
        },
        "added_files": { "type": ["integer", "null"], "minimum": 0 },
        "added_or_changed_lines": { "type": ["integer", "null"], "minimum": 0 },
        "repeated_inputs": { "type": ["integer", "null"], "minimum": 0 },
        "observer_prompts": { "type": ["integer", "null"], "minimum": 0 },
        "help_or_tool_exits": { "type": ["integer", "null"], "minimum": 0 },
        "mistaken_or_cancelled_actions": { "type": ["integer", "null"], "minimum": 0 },
        "correctness_check": { "type": "string", "maxLength": 1000 },
        "participant_explanation": { "type": "string", "maxLength": 1000 },
        "failure_or_limitation": { "type": "string", "maxLength": 1000 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "record_status": { "const": "observed" } }, "required": ["record_status"] },
      "then": {
        "properties": {
          "consent_confirmed": { "const": true },
          "anonymization_reviewed": { "const": true }
        }
      }
    }
  ]
}
